# ──────────────────────────────────────────────
# Python / Backend
# ──────────────────────────────────────────────

# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
.env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/

# Environment variables / secrets
.env
.env.local
.env.*.local

# ──────────────────────────────────────────────
# Databases
# ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ──────────────────────────────────────────────
# ML models (large binary files — regenerate via train.py)
# ──────────────────────────────────────────────
backend/app/ml/models/*.pkl
backend/app/ml/models/*.joblib

# ──────────────────────────────────────────────
# Uploaded data files
# ──────────────────────────────────────────────
backend/uploads/

# ──────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ──────────────────────────────────────────────
# IDEs & OS
# ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ──────────────────────────────────────────────
# Kiro IDE
# ──────────────────────────────────────────────
.kiro/
